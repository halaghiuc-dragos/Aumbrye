root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{gd,tscn,tres,godot}]
indent_style = tab

[*.{ts,tsx,js,mjs,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all

[*.md]
trim_trailing_whitespace = false
