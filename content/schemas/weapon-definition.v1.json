{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/weapon-definition.v1.json",
  "title": "WeaponDefinition",
  "description": "M1 sword moveset content (minimal v1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "buffer_window", "light_attacks", "heavy_attack"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "buffer_window": { "type": "number", "minimum": 0 },
    "light_attacks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attack_frame_data" }
    },
    "heavy_attack": { "$ref": "#/$defs/attack_frame_data" }
  },
  "$defs": {
    "attack_frame_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["damage", "poise_damage", "stamina_cost", "startup", "active", "recovery"],
      "properties": {
        "damage": { "type": "number", "minimum": 0 },
        "poise_damage": { "type": "number", "minimum": 0 },
        "stamina_cost": { "type": "number", "minimum": 0 },
        "startup": { "type": "number", "minimum": 0 },
        "active": { "type": "number", "minimum": 0 },
        "recovery": { "type": "number", "minimum": 0 }
      }
    }
  }
}
