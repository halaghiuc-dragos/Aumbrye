{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/weapon-definition.v1.json",
  "title": "WeaponDefinition",
  "description": "M1 sword moveset content (minimal v1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "buffer_window", "light_attacks", "heavy_attack"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "archetype": { "type": "string" },
    "damage_type": { "type": "string" },
    "status_on_hit": { "type": "string" },
    "draw_time": { "type": "number", "minimum": 0 },
    "lunge_distance": { "type": "number", "minimum": 0 },
    "buffer_window": { "type": "number", "minimum": 0 },
    "cancel_into": { "$ref": "#/$defs/cancel_into" },
    "cancel_after": { "type": "number", "minimum": 0, "maximum": 1 },
    "attack_while_guarding": { "type": "boolean" },
    "backstab_multiplier": { "type": "number", "exclusiveMinimum": 1 },
    "scaling": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "hitbox": { "$ref": "#/$defs/hitbox_shape" },
    "light_attacks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attack_frame_data" }
    },
    "heavy_attack": { "$ref": "#/$defs/attack_frame_data" },
    "heavy_attacks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attack_frame_data" }
    },
    "running_attack": { "$ref": "#/$defs/attack_frame_data" },
    "rolling_attack": { "$ref": "#/$defs/attack_frame_data" },
    "plunge_attack": { "$ref": "#/$defs/plunge_attack" },
    "art": { "$ref": "#/$defs/weapon_art" }
  },
  "$defs": {
    "cancel_into": {
      "type": "array",
      "items": { "type": "string", "enum": ["dodge", "guard"] },
      "uniqueItems": true
    },
    "hitbox_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": { "type": "string", "enum": ["box", "capsule", "arc", "sphere"] },
        "size": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "offset": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "pitch_deg": { "type": "number" }
      }
    },
    "weapon_art": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stamina_cost", "damage", "poise_damage", "startup", "active", "recovery"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "stamina_cost": { "type": "number", "minimum": 0 },
        "damage": { "type": "number", "minimum": 0 },
        "poise_damage": { "type": "number", "minimum": 0 },
        "startup": { "type": "number", "minimum": 0 },
        "active": { "type": "number", "minimum": 0 },
        "recovery": { "type": "number", "minimum": 0 },
        "lunge_distance": { "type": "number", "minimum": 0 },
        "hyperarmor": { "type": "boolean" },
        "damage_type": { "type": "string" },
        "status": { "type": "string" },
        "status_stacks": { "type": "integer", "minimum": 1 },
        "cooldown": { "type": "number", "minimum": 0 },
        "knockback": { "type": "number", "minimum": 0 }
      }
    },
    "attack_frame_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["damage", "poise_damage", "stamina_cost", "startup", "active", "recovery"],
      "properties": {
        "damage": { "type": "number", "minimum": 0 },
        "poise_damage": { "type": "number", "minimum": 0 },
        "stamina_cost": { "type": "number", "minimum": 0 },
        "mana_cost": { "type": "number", "minimum": 0 },
        "startup": { "type": "number", "minimum": 0 },
        "active": { "type": "number", "minimum": 0 },
        "recovery": { "type": "number", "minimum": 0 },
        "lunge_distance": { "type": "number", "minimum": 0 },
        "damage_type": { "type": "string" },
        "status": { "type": "string" },
        "status_stacks": { "type": "integer", "minimum": 1 },
        "hyperarmor": { "type": "boolean" },
        "heavy_branch": { "type": "integer", "minimum": 0 },
        "cancel_into": { "$ref": "#/$defs/cancel_into" },
        "cancel_after": { "type": "number", "minimum": 0, "maximum": 1 },
        "knockback": { "type": "number", "minimum": 0 },
        "charge": { "$ref": "#/$defs/charge" }
      }
    },
    "charge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_time", "damage_mult", "poise_mult", "stamina_mult", "hyperarmor_at"],
      "properties": {
        "max_time": { "type": "number", "exclusiveMinimum": 0 },
        "damage_mult": { "type": "number", "minimum": 1 },
        "poise_mult": { "type": "number", "minimum": 1 },
        "stamina_mult": { "type": "number", "minimum": 1 },
        "hyperarmor_at": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "plunge_attack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["damage", "poise_damage", "stamina_cost"],
      "properties": {
        "damage": { "type": "number", "minimum": 0 },
        "poise_damage": { "type": "number", "minimum": 0 },
        "stamina_cost": { "type": "number", "minimum": 0 },
        "damage_type": { "type": "string" },
        "knockback": { "type": "number", "minimum": 0 }
      }
    }
  }
}
