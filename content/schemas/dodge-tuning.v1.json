{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/dodge-tuning.v1.json",
  "title": "DodgeTuning",
  "description": "Roll proportions per armour weight class.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "weight_classes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "weight_from_defense": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light_below": { "type": "number", "minimum": 0 },
        "heavy_at_or_above": { "type": "number", "minimum": 0 }
      }
    },
    "weight_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "medium", "heavy"],
      "properties": {
        "light": { "$ref": "#/$defs/roll_profile" },
        "medium": { "$ref": "#/$defs/roll_profile" },
        "heavy": { "$ref": "#/$defs/roll_profile" }
      }
    }
  },
  "$defs": {
    "roll_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "recovery",
        "iframe_start",
        "iframe_end",
        "peak_speed",
        "end_speed"
      ],
      "properties": {
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "recovery": { "type": "number", "minimum": 0 },
        "iframe_start": { "type": "number", "minimum": 0 },
        "iframe_end": { "type": "number", "minimum": 0 },
        "peak_speed": { "type": "number", "minimum": 0 },
        "end_speed": { "type": "number", "minimum": 0 },
        "recovery_speed_mult": { "type": "number", "minimum": 0, "maximum": 1 },
        "stamina_cost_mult": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
