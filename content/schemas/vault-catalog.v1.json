{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/vault-catalog.v1.json",
  "title": "VaultCatalog",
  "description": "Permanent per-character unlocks that add relics, items and descent pacts to the run pools.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "note": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "grants", "name", "trigger"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "type": { "enum": ["relic", "item", "pact"] },
        "grants": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "flavour": { "type": "string" },
        "trigger": { "$ref": "#/$defs/trigger" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "biomeCleared",
            "dungeonDepth",
            "dungeonDepthCleared",
            "enemyKills",
            "totalKills",
            "deaths",
            "wavesWave",
            "wavesCompletions"
          ]
        },
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
