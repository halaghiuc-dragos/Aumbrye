{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/bestiary-catalog.v1.json",
  "title": "BestiaryCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enemyId", "name", "sighted", "studied", "mastered"],
        "properties": {
          "enemyId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "biomeId": { "type": "string", "minLength": 1 },
          "sighted": { "type": "string", "minLength": 1 },
          "studied": { "type": "string", "minLength": 1 },
          "mastered": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
