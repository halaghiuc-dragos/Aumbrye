{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/biome-definition.v2.json",
  "title": "BiomeDefinitionV2",
  "description": "Full biome kit — procgen, materials, lighting, audio, props, loot, traps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "templatePrefix",
    "assetFolder",
    "roomCount",
    "roomTemplateIds",
    "materials",
    "lighting",
    "audioProfile",
    "propKit",
    "enemyPool",
    "bossPool",
    "budgets",
    "trapPool",
    "finalFloor"
  ],
  "anyOf": [{ "required": ["lootTables"] }, { "required": ["lootTablePath"] }],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "templatePrefix": { "type": "string", "minLength": 1 },
    "assetFolder": { "type": "string", "minLength": 1 },
    "roomCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "roomTemplateIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["floor", "wall", "ceiling", "accent"],
      "properties": {
        "floor": { "type": "string", "pattern": "^[a-z_]+$" },
        "wall": { "type": "string", "pattern": "^[a-z_]+$" },
        "ceiling": { "type": "string", "pattern": "^[a-z_]+$" },
        "accent": { "type": "string", "pattern": "^[a-z_]+$" }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambientColor",
        "ambientEnergy",
        "fogEnabled",
        "fogColor",
        "fogDensity",
        "torchColor",
        "torchEnergy"
      ],
      "properties": {
        "ambientColor": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "ambientEnergy": { "type": "number", "minimum": 0 },
        "fogEnabled": { "type": "boolean" },
        "fogColor": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "fogDensity": { "type": "number", "minimum": 0 },
        "torchColor": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "torchEnergy": { "type": "number", "minimum": 0 }
      }
    },
    "audioProfile": { "type": "string", "minLength": 1 },
    "propKit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pillar", "sconce", "rubble"],
      "properties": {
        "pillar": { "type": "string", "minLength": 1 },
        "sconce": { "type": "string", "minLength": 1 },
        "rubble": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "enemyPool": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enemyId", "weight"],
        "properties": {
          "enemyId": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "bossPool": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enemyId"],
        "properties": {
          "enemyId": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1 }
        }
      },
      "minItems": 2
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseEnemyThreat", "baseLootValue", "threatPerTier", "lootPerTier"],
      "properties": {
        "baseEnemyThreat": { "type": "integer", "minimum": 0 },
        "baseLootValue": { "type": "integer", "minimum": 0 },
        "threatPerTier": { "type": "integer", "minimum": 0 },
        "lootPerTier": { "type": "integer", "minimum": 0 }
      }
    },
    "lootTablePath": {
      "type": "string",
      "minLength": 1,
      "description": "External loot table JSON under content/loot/tables/."
    },
    "lootTables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treasure", "secret", "side", "armory"],
      "properties": {
        "treasure": { "$ref": "#/definitions/lootEntries" },
        "secret": { "$ref": "#/definitions/lootEntries" },
        "side": { "$ref": "#/definitions/lootEntries" },
        "armory": { "$ref": "#/definitions/lootEntries" }
      }
    },
    "trapPool": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trapId", "weight"],
        "properties": {
          "trapId": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1 }
        }
      },
      "minItems": 1
    },
    "requiresSecret": { "type": "boolean" },
    "maxSecrets": { "type": "integer", "minimum": 0, "maximum": 4 },
    "maxHeightLevel": { "type": "integer", "minimum": 0, "maximum": 2 },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shadowTint": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "shadowTintAmount": { "type": "number", "minimum": 0, "maximum": 1 },
        "highlightTint": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "highlightTintAmount": { "type": "number", "minimum": 0, "maximum": 1 },
        "saturation": { "type": "number", "minimum": 0, "maximum": 2 },
        "contrast": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "lift": { "type": "number", "minimum": -0.2, "maximum": 0.2 },
        "vignette": { "type": "number", "minimum": 0, "maximum": 1 },
        "vignetteSoftness": { "type": "number", "minimum": 0.1, "maximum": 2 },
        "posterizeLevels": { "type": "number", "minimum": 0, "maximum": 64 }
      }
    },
    "finalFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bossId"],
      "properties": {
        "bossId": { "type": "string", "minLength": 1 },
        "lobbyChests": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  },
  "definitions": {
    "lootEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "quantity", "weight"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "quantity": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "minItems": 2,
            "maxItems": 2
          },
          "weight": { "type": "integer", "minimum": 1 },
          "minTier": { "type": "integer", "minimum": 1 }
        }
      },
      "minItems": 1
    }
  }
}
