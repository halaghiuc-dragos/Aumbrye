{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/hub-growth.v1.json",
  "title": "Hub growth dressing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "anchor",
          "prop",
          "description",
          "condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "anchor": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "prop": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 8
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dungeonsCleared": {
                "type": "integer",
                "minimum": 0
              },
              "maxUnlockedTier": {
                "type": "integer",
                "minimum": 0
              },
              "bestiaryStudied": {
                "type": "integer",
                "minimum": 0
              },
              "bestiaryMastered": {
                "type": "integer",
                "minimum": 0
              },
              "endlessBestFloor": {
                "type": "integer",
                "minimum": 0
              },
              "bountyTokens": {
                "type": "integer",
                "minimum": 0
              },
              "descentTokens": {
                "type": "integer",
                "minimum": 0
              },
              "runsRecorded": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
