{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/run-mode-catalog.v1.json",
  "title": "Alternate run modes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "baseMode",
          "description",
          "scoring",
          "modifiers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "baseMode": {
            "enum": [
              "castle",
              "endless"
            ]
          },
          "dungeonId": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "floors": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "description": {
            "type": "string",
            "minLength": 8
          },
          "flavour": {
            "type": "string",
            "minLength": 8
          },
          "scoring": {
            "enum": [
              "time",
              "depth",
              "kills"
            ]
          },
          "permadeath": {
            "type": "boolean"
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "escalation": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fromFloor",
                "modifiers"
              ],
              "properties": {
                "fromFloor": {
                  "type": "integer",
                  "minimum": 1
                },
                "modifiers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  }
                }
              }
            }
          },
          "unlock": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dungeonsCleared": {
                "type": "integer",
                "minimum": 0
              },
              "maxUnlockedTier": {
                "type": "integer",
                "minimum": 0
              },
              "bestiaryStudied": {
                "type": "integer",
                "minimum": 0
              },
              "bestiaryMastered": {
                "type": "integer",
                "minimum": 0
              },
              "endlessBestFloor": {
                "type": "integer",
                "minimum": 0
              },
              "bountyTokens": {
                "type": "integer",
                "minimum": 0
              },
              "descentTokens": {
                "type": "integer",
                "minimum": 0
              },
              "runsRecorded": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
