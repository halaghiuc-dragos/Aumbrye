{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/waves-definition.v1.json",
  "title": "WavesDefinition",
  "description": "The Vigil: wave pacing, roster bands, boss bands, and lobby chest tables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "finalWave",
    "intermissionEvery",
    "bossEvery",
    "count",
    "base_roster",
    "boss_unlocks",
    "chests"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "note": { "type": "string" },
    "finalWave": { "type": "integer", "minimum": 1 },
    "intermissionEvery": { "type": "integer", "minimum": 1 },
    "bossEvery": { "type": "integer", "minimum": 1 },
    "cashOutFromWave": { "type": "integer", "minimum": 1 },
    "arenaStates": {
      "type": "array",
      "items": { "type": "string", "enum": ["open", "dimmed", "hazard", "fog", "pillars"] }
    },
    "milestones": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "per_half_wave", "cap", "milestone_bonus"],
      "properties": {
        "base": { "type": "integer", "minimum": 0 },
        "per_half_wave": { "type": "integer", "minimum": 0 },
        "cap": { "type": "integer", "minimum": 1 },
        "milestone_bonus": { "type": "integer", "minimum": 0 }
      }
    },
    "encounter_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_ranged_ratio", "max_long_reach_ratio", "max_fast_ratio", "max_control_ratio", "min_melee_count", "max_average_threat_cost"],
      "properties": {
        "max_ranged_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_long_reach_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_fast_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_control_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_melee_count": { "type": "integer", "minimum": 0 },
        "max_average_threat_cost": { "type": "number", "minimum": 0 }
      }
    },
    "base_roster": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "roster_unlocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/waveBand" }
    },
    "boss_unlocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/waveBand" }
    },
    "milestone_bosses": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "chests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chest" }
    }
  },
  "$defs": {
    "waveBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave", "ids"],
      "properties": {
        "wave": { "type": "integer", "minimum": 1 },
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "rarity_weights", "pool"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 },
        "rarity_weights": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "pool": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "multi_grant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
