{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/waves-definition.v1.json",
  "title": "WavesDefinition",
  "description": "Umbral Waves wave roster, milestones, and lobby chest tables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "milestones",
    "count",
    "base_roster",
    "milestone_bosses",
    "chests"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "per_half_wave", "cap", "milestone_bonus"],
      "properties": {
        "base": { "type": "integer", "minimum": 0 },
        "per_half_wave": { "type": "integer", "minimum": 0 },
        "cap": { "type": "integer", "minimum": 1 },
        "milestone_bonus": { "type": "integer", "minimum": 0 }
      }
    },
    "base_roster": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "roster_unlocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wave", "ids"],
        "properties": {
          "wave": { "type": "integer", "minimum": 1 },
          "ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "milestone_bosses": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "chests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chest" }
    }
  },
  "$defs": {
    "chest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "rarity_weights", "pool"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 },
        "rarity_weights": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "pool": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "multi_grant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
