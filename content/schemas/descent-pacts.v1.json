{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/descent-pacts.v1.json",
  "title": "DescentPacts",
  "description": "Pacts offered at the stair lever. Each trades a stated gain against a stated cost by adding or removing run modifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pacts"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "offerCount": { "type": "integer", "minimum": 1 },
    "pacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pact" } }
  },
  "$defs": {
    "pact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "gain": { "type": "string" },
        "cost": { "type": "string" },
        "modifiers": { "$ref": "#/$defs/modifierList" },
        "removeModifiers": { "$ref": "#/$defs/modifierList" }
      }
    },
    "modifierList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
