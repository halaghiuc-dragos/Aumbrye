{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/enemy-definition.v1.json",
  "title": "EnemyDefinition",
  "description": "M1 training enemy and future enemy content (minimal v1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "scene",
    "health",
    "poise",
    "move_speed",
    "attack_damage",
    "attack_poise_damage",
    "windup_duration",
    "active_duration",
    "recovery_duration",
    "attack_range",
    "attack_cooldown",
    "stagger_duration"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "scene": { "type": "string", "minLength": 1 },
    "threat_cost": { "type": "integer", "minimum": 0 },
    "health": { "type": "number", "exclusiveMinimum": 0 },
    "poise": { "type": "number", "minimum": 0 },
    "move_speed": { "type": "number", "exclusiveMinimum": 0 },
    "attack_damage": { "type": "number", "minimum": 0 },
    "attack_poise_damage": { "type": "number", "minimum": 0 },
    "windup_duration": { "type": "number", "minimum": 0 },
    "active_duration": { "type": "number", "minimum": 0 },
    "recovery_duration": { "type": "number", "minimum": 0 },
    "attack_range": { "type": "number", "exclusiveMinimum": 0 },
    "attack_cooldown": { "type": "number", "minimum": 0 },
    "stagger_duration": { "type": "number", "minimum": 0 },
    "aggro_range": { "type": "number", "exclusiveMinimum": 0 },
    "deaggro_range": { "type": "number", "exclusiveMinimum": 0 },
    "patrol_radius": { "type": "number", "minimum": 0 },
    "preferred_range": { "type": "number", "minimum": 0 },
    "retreat_range": { "type": "number", "minimum": 0 },
    "projectile_speed": { "type": "number", "exclusiveMinimum": 0 },
    "block_mitigation": { "type": "number", "minimum": 0, "maximum": 1 },
    "block_angle_deg": { "type": "number", "minimum": 0, "maximum": 180 },
    "phase2_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "enemy_type": {
      "type": "string",
      "enum": ["melee", "ranged", "shield", "boss"]
    }
  }
}
