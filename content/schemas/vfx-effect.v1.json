{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/vfx-effect.v1.json",
  "title": "VfxEffects",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "effects", "chunks", "decals"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "effects": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/effect" }
    },
    "chunks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/chunk" }
    },
    "decals": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        ]
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layer" }
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["burst", "decal", "ribbon", "glyph", "impact", "sfx"]
        },
        "backend": { "type": "string", "enum": ["cpu", "gpu"] },
        "amount": { "type": "integer", "minimum": 1 },
        "lifetime": { "type": "number", "minimum": 0.01 },
        "explosiveness": { "type": "number", "minimum": 0, "maximum": 1 },
        "spread": { "type": "number", "minimum": 0 },
        "velocity": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "gravity": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "scale": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 }
        },
        "chunk": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "emission": { "type": "number", "minimum": 0 },
        "align_to": { "type": "string", "enum": ["direction", "forward", "up", "none"] },
        "flatness": { "type": "number", "minimum": 0, "maximum": 1 },
        "randomness": { "type": "number", "minimum": 0, "maximum": 1 },
        "decal": { "type": "string", "minLength": 1 },
        "size": { "type": "number", "minimum": 0.01 },
        "fade": { "type": "number", "minimum": 0 },
        "hitstop_ms": { "type": "integer", "minimum": 0, "maximum": 200 },
        "shake": { "type": "number", "minimum": 0, "maximum": 1 },
        "shake_ms": { "type": "integer", "minimum": 0, "maximum": 500 },
        "vignette": { "type": "number", "minimum": 0, "maximum": 1 },
        "key": { "type": "string", "minLength": 1 },
        "shape": { "type": "string", "enum": ["circle", "cone", "line"] },
        "radius": { "type": "number", "minimum": 0.1 },
        "duration": { "type": "number", "minimum": 0.05 },
        "tint": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "arc_degrees": { "type": "number", "minimum": 30, "maximum": 360 }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mesh", "size"],
      "properties": {
        "mesh": { "type": "string", "enum": ["box", "quad"] },
        "size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0.01 }
        },
        "billboard": { "type": "boolean" }
      }
    }
  }
}
