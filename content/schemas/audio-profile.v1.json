{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/audio-profile.v1.json",
  "title": "AudioProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "biomeId"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "biomeId": { "type": "string", "minLength": 1 },
    "ambienceFreq": { "type": "number", "minimum": 0 },
    "exploreFreq": { "type": "number", "minimum": 0 },
    "combatFreq": { "type": "number", "minimum": 0 },
    "bossFreq": { "type": "number", "minimum": 0 },
    "ambiencePath": { "type": "string" },
    "bossPath": { "type": "string" },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambience": { "$ref": "#/$defs/layer" },
        "explore": { "$ref": "#/$defs/layer" },
        "combat": { "$ref": "#/$defs/layer" },
        "boss": { "$ref": "#/$defs/layer" }
      }
    },
    "stingers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "reverbPreset": {
      "type": "string",
      "enum": [
        "indoor_castle",
        "cathedral",
        "cave",
        "swamp",
        "frozen",
        "vault",
        "umbral",
        "outdoor"
      ]
    },
    "crossfadeSeconds": { "type": "number", "minimum": 0, "maximum": 2 }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "volume_db": { "type": "number" },
        "fallback_freq": { "type": "number", "minimum": 0 }
      }
    }
  }
}
