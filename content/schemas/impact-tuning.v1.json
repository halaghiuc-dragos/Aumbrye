{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/impact-tuning.v1.json",
  "title": "ImpactTuning",
  "description": "Hit-stop, camera punch, controller rumble and audio layer per impact class.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "profiles"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glancing", "solid", "critical", "parry"],
      "properties": {
        "glancing": { "$ref": "#/$defs/profile" },
        "solid": { "$ref": "#/$defs/profile" },
        "critical": { "$ref": "#/$defs/profile" },
        "parry": { "$ref": "#/$defs/profile" }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeze",
        "punch",
        "shake",
        "shake_time",
        "rumble_weak",
        "rumble_strong",
        "rumble_time",
        "audio_layer"
      ],
      "properties": {
        "freeze": { "type": "number", "minimum": 0 },
        "punch": { "type": "number", "minimum": 0 },
        "shake": { "type": "number", "minimum": 0 },
        "shake_time": { "type": "number", "minimum": 0 },
        "rumble_weak": { "type": "number", "minimum": 0 },
        "rumble_strong": { "type": "number", "minimum": 0 },
        "rumble_time": { "type": "number", "minimum": 0 },
        "audio_layer": { "type": "string" }
      }
    }
  }
}
