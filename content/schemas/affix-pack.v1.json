{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/affix-pack.v1.json",
  "title": "AffixPack",
  "description": "Collection of affix definitions (prefixes or suffixes).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "affixes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "affixes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://aumbrye.dev/schemas/affix-definition.v1.json" }
    }
  }
}
