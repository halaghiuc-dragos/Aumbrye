{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/dungeon-definition.v1.json",
  "title": "DungeonDefinition",
  "description": "Server-generated dungeon layout consumed by the Godot client builder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "seed",
    "biomeId",
    "tier",
    "playerLevelSnapshot",
    "rooms",
    "edges",
    "placements",
    "budgets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "seed": {
      "type": "integer"
    },
    "biomeId": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "integer",
      "minimum": 1
    },
    "playerLevelSnapshot": {
      "type": "integer",
      "minimum": 1
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/room" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "placements": {
      "$ref": "#/$defs/placements"
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "checksum": {
      "type": "string"
    }
  },
  "$defs": {
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "yaw"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "yaw": { "type": "number" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "templateId", "type", "transform", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "templateId": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["combat", "treasure", "puzzle", "boss", "hub", "corridor", "secret"]
        },
        "transform": { "$ref": "#/$defs/transform" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["corridor", "door", "secret", "one_way"]
        }
      }
    },
    "placements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enemies",
        "loot",
        "puzzles",
        "traps",
        "secrets",
        "boss",
        "exit",
        "entrance"
      ],
      "properties": {
        "enemies": { "type": "array", "items": { "type": "object" } },
        "loot": { "type": "array", "items": { "type": "object" } },
        "puzzles": { "type": "array", "items": { "type": "object" } },
        "traps": { "type": "array", "items": { "type": "object" } },
        "secrets": { "type": "array", "items": { "type": "object" } },
        "boss": { "type": ["object", "null"] },
        "exit": { "type": ["string", "null"] },
        "entrance": { "type": "string", "minLength": 1 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enemyThreat", "lootValue"],
      "properties": {
        "enemyThreat": { "type": "number", "minimum": 0 },
        "lootValue": { "type": "number", "minimum": 0 }
      }
    }
  }
}
