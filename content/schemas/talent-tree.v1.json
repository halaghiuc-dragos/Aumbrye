{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/talent-tree.v1.json",
  "title": "TalentTree",
  "description": "Talent tree definition: shared branches plus one class-exclusive branch per class. Each branch ends in a keystone that registers rules on the shared combat event dispatcher. Talent points per level are authored on the XP curve.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "branches"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/branch"
      }
    }
  },
  "$defs": {
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nameKey",
        "nodes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nameKey": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "classId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nameKey",
        "maxRank",
        "costPerRank",
        "requires"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nameKey": {
          "type": "string",
          "minLength": 1
        },
        "maxRank": {
          "type": "integer",
          "minimum": 1
        },
        "costPerRank": {
          "type": "integer",
          "minimum": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stat",
              "valuePerRank"
            ],
            "properties": {
              "stat": {
                "type": "string",
                "minLength": 1
              },
              "valuePerRank": {
                "type": "number"
              }
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "keystone": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "effect"
            ],
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "effect": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number"
              },
              "chance": {
                "type": "number"
              },
              "cooldown": {
                "type": "number"
              },
              "pct": {
                "type": "number"
              },
              "statusId": {
                "type": "string"
              },
              "stacks": {
                "type": "integer"
              },
              "radius": {
                "type": "number"
              },
              "stackId": {
                "type": "string"
              },
              "maxStacks": {
                "type": "integer"
              },
              "stat": {
                "type": "string"
              },
              "perStack": {
                "type": "number"
              },
              "resetOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ifTargetHasStatus": {
                "type": "string"
              },
              "ifDamageType": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
