{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/encounters.v1.json",
  "title": "Encounters",
  "description": "Set-piece enemy packs: each names the role every enemy fills, the first block floor and depth it can appear at, and how often it is picked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "encounters"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slots"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "minFloor": { "type": "integer", "minimum": 1 },
          "minDepth": { "type": "integer", "minimum": 0 },
          "weight": { "type": "integer", "minimum": 1 },
          "slots": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": { "enum": ["melee", "ranged", "shield"] }
          }
        }
      }
    }
  }
}
