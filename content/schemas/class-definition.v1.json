{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/class-definition.v1.json",
  "title": "ClassDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "startingWeaponItemId", "statBonuses"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "startingWeaponItemId": { "type": "string", "minLength": 1 },
    "statBonuses": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "allowedWeapons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "perk": { "type": "string" }
  }
}
