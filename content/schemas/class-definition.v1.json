{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/class-definition.v1.json",
  "title": "ClassDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "startingWeaponItemId",
    "statBonuses"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "startingWeaponItemId": {
      "type": "string",
      "minLength": 1
    },
    "statBonuses": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "statRatings": {
      "type": "object",
      "description": "Twelve stats on the shared 4..16 rating scale, totalling 120. Authoritative: ClassCatalog derives statBonuses from these at load time.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 4,
        "maximum": 16
      }
    },
    "allowedWeapons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "perk": {
      "type": "string"
    },
    "iconPath": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "perkName": {
      "type": "string",
      "minLength": 1
    },
    "perkDescription": {
      "type": "string",
      "minLength": 1
    },
    "allowedWeaponFamilies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "talentBranchId": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event",
          "effect"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number"
          },
          "chance": {
            "type": "number"
          },
          "cooldown": {
            "type": "number"
          },
          "pct": {
            "type": "number"
          },
          "statusId": {
            "type": "string"
          },
          "stacks": {
            "type": "integer"
          },
          "radius": {
            "type": "number"
          },
          "stackId": {
            "type": "string"
          },
          "maxStacks": {
            "type": "integer"
          },
          "stat": {
            "type": "string"
          },
          "perStack": {
            "type": "number"
          },
          "resetOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ifTargetHasStatus": {
            "type": "string"
          },
          "ifDamageType": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "roleText": {
      "type": "string",
      "minLength": 1
    },
    "perkNameText": {
      "type": "string",
      "minLength": 1
    },
    "perkDescriptionText": {
      "type": "string",
      "minLength": 1
    }
  }
}
