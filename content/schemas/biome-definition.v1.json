{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/biome-definition.v1.json",
  "title": "BiomeDefinition",
  "description": "Biome procgen config — room templates, enemy pools, loot budgets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "roomCount", "roomTemplateIds", "enemyPool", "bossPool", "budgets", "lootTables", "trapPool"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "roomCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "gridStep": { "type": "integer", "minimum": 1 },
    "roomTemplateIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "enemyPool": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enemyId", "weight"],
        "properties": {
          "enemyId": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "bossPool": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enemyId"],
        "properties": {
          "enemyId": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1 }
        }
      },
      "minItems": 1
    },
    "lootTables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treasure", "secret", "side", "armory"],
      "properties": {
        "treasure": { "$ref": "#/$defs/lootTable" },
        "secret": { "$ref": "#/$defs/lootTable" },
        "side": { "$ref": "#/$defs/lootTable" },
        "armory": { "$ref": "#/$defs/lootTable" }
      }
    },
    "trapPool": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trapId", "weight"],
        "properties": {
          "trapId": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1 }
        }
      },
      "minItems": 1
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseEnemyThreat", "baseLootValue", "threatPerTier", "lootPerTier"],
      "properties": {
        "baseEnemyThreat": { "type": "integer", "minimum": 0 },
        "baseLootValue": { "type": "integer", "minimum": 0 },
        "threatPerTier": { "type": "integer", "minimum": 0 },
        "lootPerTier": { "type": "integer", "minimum": 0 }
      }
    },
    "requiresSecret": { "type": "boolean" },
    "maxSecrets": { "type": "integer", "minimum": 0, "maximum": 4 },
    "maxHeightLevel": { "type": "integer", "minimum": 0, "maximum": 2 },
    "finalFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bossId"],
      "properties": {
        "bossId": { "type": "string", "minLength": 1 },
        "lobbyChests": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "lootEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "quantity", "weight"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "quantity": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "weight": { "type": "integer", "minimum": 1 },
        "minTier": { "type": "integer", "minimum": 1 }
      }
    },
    "lootTable": {
      "type": "array",
      "items": { "$ref": "#/$defs/lootEntry" },
      "minItems": 1
    }
  }
}
