{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/endless-depth.v1.json",
  "title": "EndlessDepth",
  "description": "Umbral Endless depth ratchet: descent-token income, milestone rewards, and the ladder that converts small floor-skip items into larger ones.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "milestones"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "tokensPerNewFloor": { "type": "integer", "minimum": 0 },
    "tokenBonusPerMilestone": { "type": "integer", "minimum": 0 },
    "milestones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/milestone" } },
    "skipLadder": { "type": "array", "items": { "$ref": "#/$defs/skipConversion" } }
  },
  "$defs": {
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["floor", "flag"],
      "properties": {
        "floor": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "flag": { "type": "string", "minLength": 1 },
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokens": { "type": "integer", "minimum": 0 },
            "skipItemId": { "type": "string", "minLength": 1 },
            "skipQuantity": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "skipConversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "cost"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "cost": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
