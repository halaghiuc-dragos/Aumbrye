{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/challenge-rotation.v1.json",
  "title": "Weekly challenge rotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "epochUnix",
    "seedSalt",
    "rotation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "epochUnix": {
      "type": "integer",
      "minimum": 0
    },
    "seedSalt": {
      "type": "integer",
      "minimum": 1
    },
    "rotation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "dungeonId",
          "difficultyTier",
          "modifiers",
          "scoring"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 8
          },
          "dungeonId": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "difficultyTier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "modifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "scoring": {
            "enum": [
              "time",
              "depth",
              "kills"
            ]
          }
        }
      }
    }
  }
}
