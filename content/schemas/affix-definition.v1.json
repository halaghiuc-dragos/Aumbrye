{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/affix-definition.v1.json",
  "title": "AffixDefinition",
  "description": "Single affix entry used in prefix/suffix packs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "prefix",
        "suffix"
      ]
    },
    "stat": {
      "type": "string",
      "minLength": 1
    },
    "itemTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "weapon",
          "armor",
          "accessory"
        ]
      },
      "minItems": 1
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "common": {
          "$ref": "#/$defs/tier"
        },
        "magic": {
          "$ref": "#/$defs/tier"
        },
        "rare": {
          "$ref": "#/$defs/tier"
        },
        "epic": {
          "$ref": "#/$defs/tier"
        },
        "legendary": {
          "$ref": "#/$defs/tier"
        },
        "aumbral": {
          "$ref": "#/$defs/tier"
        }
      }
    },
    "weight": {
      "type": "integer",
      "minimum": 1
    },
    "valueStyle": {
      "type": "string",
      "enum": [
        "fraction",
        "integer"
      ],
      "description": "How the tier range is sampled. 'fraction' interpolates continuously across [min,max] (multipliers, percentages); 'integer' draws a whole number inclusively. Omitting it falls back to a magnitude heuristic that cannot tell a genuinely fractional range like 1.2-2.4 apart from an integer one, so new affixes should always declare it."
    },
    "template": {
      "type": "string",
      "description": "Tooltip line pattern; {value} and {stat} are substituted at render time."
    },
    "ruleText": {
      "type": "string",
      "minLength": 1,
      "description": "Player-facing rules text for a behavioural affix, shown in place of a stat line."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "description": "CombatEvents rule declarations registered while an item carrying this affix is equipped.",
      "items": {
        "type": "object"
      }
    },
    "minRarity": {
      "type": "string",
      "enum": [
        "common",
        "magic",
        "rare",
        "epic",
        "legendary",
        "aumbral"
      ],
      "description": "Lowest item rarity this affix can roll on. Defaults to common."
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    }
  }
}
