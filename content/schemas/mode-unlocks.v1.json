{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/mode-unlocks.v1.json",
  "title": "ModeUnlocks",
  "description": "Unlock gating and hub portal presentation for the three core run modes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "note": { "type": "string" },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mode" }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "portalNode", "displayName", "requirements"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "portalNode": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "lockedLabel": { "type": "string" },
        "announce": { "type": "string" },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "text"],
      "properties": {
        "type": {
          "enum": ["dungeonDepth", "dungeonDepthCleared", "wavesCompletions"]
        },
        "value": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
