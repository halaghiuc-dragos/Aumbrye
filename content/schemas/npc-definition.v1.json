{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aumbrye.dev/schemas/npc-definition.v1.json",
  "title": "NpcDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "interactType"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "interactType": {
      "enum": [
        "dialogue",
        "blacksmith",
        "merchant",
        "quest_board",
        "storage",
        "bounty_board"
      ]
    },
    "dialogueId": { "type": "string" },
    "requiresFlag": { "type": "string", "minLength": 1 },
    "dialogueRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dialogueId"],
        "properties": {
          "dialogueId": { "type": "string", "minLength": 1 },
          "condition": { "type": "object" }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    }
  }
}
