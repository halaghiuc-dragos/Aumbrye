; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Aumbrye"
config/description="Action roguelite RPG"
config/version="0.4.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[aumbrye]

content_root=""
strict_item_catalog=false

[autoload]

RunFlow="*res://scripts/app/run_flow.gd"
ApiConfig="*res://scripts/net/api_config.gd"
LocalSave="*res://scripts/save/local_save.gd"
CharacterService="*res://scripts/save/character_service.gd"
ProgressionService="*res://scripts/progression/progression_service.gd"
RunBuffs="*res://scripts/combat/run_buffs.gd"
CombatEvents="*res://scripts/combat/combat_events.gd"
InventoryService="*res://scripts/inventory/inventory_service.gd"
StorageService="*res://scripts/hub/storage_service.gd"
QuestService="*res://scripts/quests/quest_service.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
AchievementService="*res://scripts/meta/achievement_service.gd"
SteamService="*res://scripts/platform/steam_service.gd"
CrashLogger="*res://scripts/platform/crash_logger.gd"
WavesRunService="*res://scripts/dungeon/waves_run_service.gd"
DungeonTierService="*res://scripts/dungeon/dungeon_tier_service.gd"
VfxService="*res://scripts/art/vfx/vfx_service.gd"
DisplayService="*res://scripts/app/display_service.gd"
PlayerControls="*res://scripts/app/player_controls.gd"
MenuStack="*res://scripts/ui/menu_stack.gd"
WorldState="*res://scripts/app/world_state.gd"
PixelDioramaViewport="*res://scripts/art/pipeline/pixel_diorama_viewport.gd"
AttackTokenService="*res://scripts/combat/attack_token_service.gd"
GameFacade="*res://scripts/app/game_facade.gd"
InputRebindService="*res://scripts/app/input_rebind_service.gd"
DebugConsole="*res://scripts/debug/debug_console.gd"
InputGlyphWatcher="*res://scripts/ui/input_glyph_watcher.gd"
UISymbolBus="*res://scripts/ui/ui_symbol_bus.gd"

[debug]

gdscript/warnings/unassigned_variable=2
gdscript/warnings/unassigned_variable_op_assign=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_local_constant=2
gdscript/warnings/unused_private_class_variable=2
gdscript/warnings/unused_parameter=2
gdscript/warnings/unused_signal=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/shadowed_global_identifier=2
gdscript/warnings/unreachable_code=2
gdscript/warnings/unreachable_pattern=2
gdscript/warnings/standalone_expression=2
gdscript/warnings/standalone_ternary=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/static_called_on_instance=2
gdscript/warnings/missing_tool=2
gdscript/warnings/redundant_static_unload=2
gdscript/warnings/redundant_await=2
gdscript/warnings/assert_always_true=2
gdscript/warnings/assert_always_false=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/enum_variable_without_default=2
gdscript/warnings/empty_file=2
gdscript/warnings/deprecated_keyword=2
gdscript/warnings/confusable_identifier=2
gdscript/warnings/confusable_local_declaration=2
gdscript/warnings/confusable_local_usage=2
gdscript/warnings/confusable_capture_reassignment=2
gdscript/warnings/confusable_temporary_modification=2
gdscript/warnings/property_used_as_function=2
gdscript/warnings/constant_used_as_function=2
gdscript/warnings/function_used_as_property=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

theme/custom="res://assets/ui/aumbrye_ui.tres"

[importer_defaults]

texture={
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false
}

