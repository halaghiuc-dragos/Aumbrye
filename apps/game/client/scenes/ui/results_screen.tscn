[node name="TimeLabel" type="Label" parent="Panel/Margin/VBox"]
theme_type_variation = "StatValue"
layout_mode = 2
text = "Time: --"

[node name="KillsLabel" type="Label" parent="Panel/Margin/VBox"]
theme_type_variation = "StatValue"
layout_mode = 2
