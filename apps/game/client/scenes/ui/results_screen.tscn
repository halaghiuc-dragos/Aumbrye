[node name="XpLabel" type="Label" parent="Panel/Margin/VBox"]
theme_type_variation = "StatValue"
layout_mode = 2
text = "XP: --"

[node name="RulesLabel" type="Label" parent="Panel/Margin/VBox"]
theme_type_variation = "BodyText"
layout_mode = 2
